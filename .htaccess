# The webspace's Apache serves .webmanifest with no Content-Type at all, so the
# browser gets an untyped manifest. Name the types it does not know here.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp               .webp
    AddType image/svg+xml            .svg
    AddType font/woff2               .woff2
    AddType font/otf                 .otf
</IfModule>

# Cache policy: index.html revalidates on every load, while everything it
# references caches for a year. That is safe because js/css URLs carry a
# ?v=<version> stamp from build-zip.sh, and fonts/images only ever change
# alongside a release anyway. Guarded so an Apache without mod_headers still
# serves the site, just without the headers.
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(woff2|otf|png|webp|svg|js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
