# Convention output folders, generated by build-zip.sh, never committed
/ClacketyClack Dist/
/ClacketyClack Git/
/ClacketyClack Web/

# Tooling / generated
/.claude/
node_modules/

# Archives, logs, temp
*.zip
*.7z
*.log
*.tmp

# Secrets. None exist in this project today; backstop patterns so one never
# lands in the repo by accident
.env
*credential*
*password*
*secret*
*[fF][tT][pP]*
*.pem
*.key
id_rsa*
